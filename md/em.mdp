; Minimización de energía - steepest descent
integrator      = steep
emtol           = 1000.0
emstep          = 0.01
nsteps          = 50000

; Parámetros de vecindad
cutoff-scheme   = Verlet
nstlist         = 10
ns_type         = grid
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz

; Sin control de temperatura/presión durante minimización
tcoupl          = no
pcoupl          = no
gen_vel         = no

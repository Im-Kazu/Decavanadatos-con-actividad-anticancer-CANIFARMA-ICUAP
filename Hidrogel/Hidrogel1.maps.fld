# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by D:\Programas\AutoDock4\4.2.6\autogrid4.exe.
#
#SPACING 0.375
#NELEMENTS 98 60 80
#CENTER 14.558 -18.575 0.000
#MACROMOLECULE Hidrogel1.pdbqt
#GRID_PARAMETER_FILE Hidrogel1.gpf
#
ndim=3			# number of dimensions in the field
dim1=99			# number of x-elements
dim2=61			# number of y-elements
dim3=81			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=4		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=Hidrogel1.maps.xyz filetype=ascii offset=0
coord 2 file=Hidrogel1.maps.xyz filetype=ascii offset=2
coord 3 file=Hidrogel1.maps.xyz filetype=ascii offset=4
label=OA-affinity	# component label for variable 1
label=Zn-affinity	# component label for variable 2
label=Electrostatics	# component label for variable 2
label=Desolvation	# component label for variable 3
#
# location of affinity grid files and how to read them
#
variable 1 file=Hidrogel1.OA.map filetype=ascii skip=6
variable 2 file=Hidrogel1.Zn.map filetype=ascii skip=6
variable 3 file=Hidrogel1.e.map filetype=ascii skip=6
variable 4 file=Hidrogel1.d.map filetype=ascii skip=6

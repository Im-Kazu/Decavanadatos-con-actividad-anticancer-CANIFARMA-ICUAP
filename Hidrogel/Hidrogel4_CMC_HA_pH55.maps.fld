#
#SPACING 0.375
#NELEMENTS 52 52 52
#CENTER 0.060 0.070 0.000
#MACROMOLECULE Hidrogel4_CMC_HA_pH55.pdbqt
#GRID_PARAMETER_FILE Hidrogel4_pH55.gpf
#
ndim=3			# number of dimensions in the field
dim1=53			# number of x-elements
dim2=53			# number of y-elements
dim3=53			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=4		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=Hidrogel4_CMC_HA_pH55.maps.xyz filetype=ascii offset=0
coord 2 file=Hidrogel4_CMC_HA_pH55.maps.xyz filetype=ascii offset=2
coord 3 file=Hidrogel4_CMC_HA_pH55.maps.xyz filetype=ascii offset=4
label=OA-affinity	# component label for variable 1
label=Zn-affinity	# component label for variable 2
label=Electrostatics	# component label for variable 2
label=Desolvation	# component label for variable 3
#
# location of affinity grid files and how to read them
#
variable 1 file=Hidrogel4_CMC_HA_pH55.OA.map filetype=ascii skip=6
variable 2 file=Hidrogel4_CMC_HA_pH55.Zn.map filetype=ascii skip=6
variable 3 file=Hidrogel4_CMC_HA_pH55.e.map filetype=ascii skip=6
variable 4 file=Hidrogel4_CMC_HA_pH55.d.map filetype=ascii skip=6

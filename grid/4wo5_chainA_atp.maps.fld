#SPACING 0.375
#NELEMENTS 80 80 80
#CENTER -28.233 -12.202 -28.237
#MACROMOLECULE ../receptor/4wo5_chainA.pdbqt
#GRID_PARAMETER_FILE atp_pocket.gpf
#
ndim=3			# number of dimensions in the field
dim1=81			# number of x-elements
dim2=81			# number of y-elements
dim3=81			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=4		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=4wo5_chainA_atp.maps.xyz filetype=ascii offset=0
coord 2 file=4wo5_chainA_atp.maps.xyz filetype=ascii offset=2
coord 3 file=4wo5_chainA_atp.maps.xyz filetype=ascii offset=4
label=Zn-affinity	# component label for variable 1
label=OA-affinity	# component label for variable 2
label=Electrostatics	# component label for variable 3
label=Desolvation	# component label for variable 4
#
# location of affinity grid files and how to read them
#
variable 1 file=4wo5_chainA.Zn.map filetype=ascii skip=6
variable 2 file=4wo5_chainA.OA.map filetype=ascii skip=6
variable 3 file=4wo5_chainA.e.map filetype=ascii skip=6
variable 4 file=4wo5_chainA.d.map filetype=ascii skip=6
